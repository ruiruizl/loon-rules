#!name=Qianwen to OpenRouter (inline)
#!desc=把 Siri 发往千问的文本请求改由 OpenRouter 的 GPT 回答【内联版，无远程依赖】
#!system=iOS
#!author=NOIR
#!version=1.2.0

[Script]
qwen2or.request = type=http-request,pattern=^https?:\/\/(guzzoni|seed\.siri|.+\.apple-relay|.+\.smoot)\.apple\.com\/,requires-body=1,max-size=-1,timeout=60,script-,argument=mode=auto&model=openai/gpt-5.2&key=sk-or-v1-TOKEN_HERE

[MITM]
h2 = true
hostname = %APPEND% guzzoni.apple.com, seed.siri.apple.com, *.apple-relay.apple.com, *.smoot.apple.com, chat.qwen.ai, *.qwen.com, *.qianwen.com, *.dashscope.aliyuncs.com, *.bailian.aliyuncs.com
